// prisma/schema.prisma
// LABE Attendance Management System Database Schema
// Target Database: Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OFFICE_STAFF
  FIELD_STAFF
}

enum EmployeeType {
  OFFICE_STAFF
  FIELD_STAFF
  ADMIN
  SUPER_ADMIN
}

enum EmployeeStatus {
  PENDING_APPROVAL // Self-registered, awaiting admin approval
  ACTIVE
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum FieldTaskStatus {
  PENDING // Assigned, not yet visited
  VISITED // Staff checked in inside the task geofence
  COMPLETED // Completion note submitted before the deadline
  LATE_COMPLETED // Completed after deadline under admin-granted late access
  CANCELLED
}

enum LateAccessStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
  ABSENT
  CORRECTED
  PENDING_CORRECTION
}

enum LocationRefType {
  BRANCH
  FIELD_TASK
  TERRITORY // Sales executive: anywhere inside the distribution centre's territory
  CAMP
  ANYWHERE // Leadership (CEO / Director / Chief): no geofence, location recorded only
}

// Staff classification: who the person is and how they mark attendance
enum StaffCategory {
  HEAD_OFFICE // H.O.S - head office (Guntur): office geofence
  REGIONAL_OFFICE // R.O.S - regional office (Tirupati): office geofence
  DISTRIBUTION_CENTER // D.C.S - distribution centre staff: DC geofence
  MARKETING_EXECUTIVE // M.E - field: restricted route (tasks) with survey data
  SALES_EXECUTIVE // S.E - field: anywhere inside the allotted DC territory + customers
  PHARMACY // Pharmacy hub & shop staff: shift-wise at their location
  LABORATORY // Laboratory staff: shift-wise at their location
  LEADERSHIP // CEO / Director / Chief staff: office or anywhere
}

// What kind of place a Branch row represents
enum LocationType {
  HEAD_OFFICE
  REGIONAL_OFFICE
  DISTRIBUTION_CENTER
  PHARMACY_HUB
  PHARMACY_SHOP
  LABORATORY
  OTHER
}

// Geofence geometry: a radius around a pin, or an exact boundary (GeoJSON polygon)
enum GeofenceShape {
  CIRCLE
  POLYGON
}

enum CorrectionType {
  MISSED_CHECKIN
  MISSED_CHECKOUT
  WRONG_LOCATION
  OTHER
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  timezone  String   @default("Asia/Kolkata") @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users                 User[]
  branches              Branch[]
  employees             Employee[]
  attendancePolicies    AttendancePolicy[]
  attendanceRecords     AttendanceRecord[]
  holidays              Holiday[]
  attendanceCorrections AttendanceCorrection[]
  auditLogs             AuditLog[]
  fieldTasks            FieldTask[]
  shifts                Shift[]
  camps                 Camp[]
  customers             Customer[]

  @@map("organizations")
}

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  role                UserRole
  isActive            Boolean   @default(true) @map("is_active")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  organization             Organization           @relation(fields: [organizationId], references: [id])
  employee                 Employee?
  createdBranchAssignments BranchAssignment[]     @relation("AssignedBy")
  assignedTasks            FieldTask[]            @relation("TaskAssignedBy")
  lateAccessReviews        FieldTask[]            @relation("LateAccessReviewedBy")
  approvedEmployees        Employee[]             @relation("ApprovedBy")
  createdPolicies          AttendancePolicy[]     @relation("PolicyCreatedBy")
  reviewedCorrections      AttendanceCorrection[] @relation("ReviewedBy")
  requestedCorrections     AttendanceCorrection[] @relation("RequestedBy")
  auditLogs                AuditLog[]
  createdEmployees         Employee[]             @relation("CreatedBy")
  createdBranches          Branch[]
  createdCamps             Camp[]                 @relation("CampCreatedBy")
  addedCustomers           Customer[]             @relation("CustomerAddedBy")

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

model Employee {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String         @unique @map("user_id") @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  employeeCode    String         @unique @map("employee_code") @db.VarChar(20)
  contactId       String?        @map("contact_id") @db.VarChar(50)
  fullName        String         @map("full_name") @db.VarChar(255)
  mobile          String         @db.VarChar(15)
  employeeType    EmployeeType   @map("employee_type")
  staffCategory   StaffCategory? @map("staff_category")
  designation     String?        @db.VarChar(120)
  dateOfJoining   DateTime?      @map("date_of_joining") @db.Date
  shiftId         String?        @map("shift_id") @db.Uuid
  status          EmployeeStatus @default(ACTIVE)
  profileNotes    String?        @map("profile_notes") @db.Text
  selfRegistered  Boolean        @default(false) @map("self_registered")
  approvedById    String?        @map("approved_by") @db.Uuid
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz
  rejectionReason String?        @map("rejection_reason") @db.Text
  createdById     String         @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz

  user                  User                   @relation(fields: [userId], references: [id])
  organization          Organization           @relation(fields: [organizationId], references: [id])
  createdBy             User                   @relation("CreatedBy", fields: [createdById], references: [id])
  approvedBy            User?                  @relation("ApprovedBy", fields: [approvedById], references: [id])
  shift                 Shift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  campAssignments       CampAssignment[]
  branchAssignments     BranchAssignment[]
  fieldTasks            FieldTask[]
  faceProfile           FaceProfile?
  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceCorrection[]
  managedBranches       Branch[]               @relation("BranchManager")

  @@index([organizationId])
  @@index([employeeCode])
  @@index([employeeType])
  @@index([staffCategory])
  @@index([status])
  @@map("employees")
}

model Branch {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  branchCode           String        @unique @map("branch_code") @db.VarChar(20)
  name                 String        @db.VarChar(255)
  address              String        @db.Text
  district             String        @db.VarChar(100)
  state                String        @default("Andhra Pradesh") @db.VarChar(100)
  latitude             Decimal       @db.Decimal(10, 7)
  longitude            Decimal       @db.Decimal(10, 7)
  geofenceRadiusMetres Int           @default(100) @map("geofence_radius_metres")
  locationType         LocationType  @default(PHARMACY_SHOP) @map("location_type")
  geofenceShape        GeofenceShape @default(CIRCLE) @map("geofence_shape")
  boundary             Json? // GeoJSON Polygon / MultiPolygon ([lng, lat]) when geofenceShape = POLYGON
  boundaryLabel        String?       @map("boundary_label") @db.VarChar(255)
  territory            Json? // Distribution centre sales territory (GeoJSON) for sales executives
  territoryLabel       String?       @map("territory_label") @db.VarChar(255)
  managerEmployeeId    String?       @map("manager_employee_id") @db.Uuid
  isActive             Boolean       @default(true) @map("is_active")
  createdById          String        @map("created_by") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization       @relation(fields: [organizationId], references: [id])
  createdBy    User               @relation(fields: [createdById], references: [id])
  manager      Employee?          @relation("BranchManager", fields: [managerEmployeeId], references: [id])
  assignments  BranchAssignment[]
  shifts       Shift[]
  camps        Camp[]
  customers    Customer[]

  @@index([organizationId])
  @@index([branchCode])
  @@map("branches")
}

model BranchAssignment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isCurrent     Boolean   @default(true) @map("is_current")
  assignedById  String    @map("assigned_by") @db.Uuid
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  employee   Employee @relation(fields: [employeeId], references: [id])
  branch     Branch   @relation(fields: [branchId], references: [id])
  assignedBy User     @relation("AssignedBy", fields: [assignedById], references: [id])

  @@index([employeeId, isCurrent])
  @@index([branchId])
  @@map("branch_assignments")
}

// A single task / stop on a field staff member's daily route.
// Field attendance is proven by visiting each task location inside its
// admin-defined radius (metres) before the task deadline.
model FieldTask {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  employeeId     String          @map("employee_id") @db.Uuid
  taskDate       DateTime        @map("task_date") @db.Date
  sequence       Int             @default(1)
  title          String          @db.VarChar(255)
  description    String?         @db.Text
  locationName   String          @map("location_name") @db.VarChar(255)
  address        String?         @db.Text
  latitude       Decimal         @db.Decimal(10, 7)
  longitude      Decimal         @db.Decimal(10, 7)
  radiusMetres   Int             @default(100) @map("radius_metres")
  geofenceShape  GeofenceShape   @default(CIRCLE) @map("geofence_shape")
  boundary       Json? // GeoJSON polygon (e.g. a village boundary) when geofenceShape = POLYGON
  boundaryLabel  String?         @map("boundary_label") @db.VarChar(255)
  deadlineTime   String          @map("deadline_time") @db.VarChar(5) // HH:MM IST on taskDate
  status         FieldTaskStatus @default(PENDING)

  // Visit (location check-in) proof
  visitedAt           DateTime? @map("visited_at") @db.Timestamptz
  visitLat            Decimal?  @map("visit_lat") @db.Decimal(10, 7)
  visitLng            Decimal?  @map("visit_lng") @db.Decimal(10, 7)
  visitAccuracyMetres Decimal?  @map("visit_accuracy_metres") @db.Decimal(8, 2)
  visitDistanceMetres Decimal?  @map("visit_distance_metres") @db.Decimal(10, 2)
  visitFaceScore      Float?    @map("visit_face_score")
  visitSelfie         String?   @map("visit_selfie") @db.Text
  visitIsMockLocation Boolean?  @map("visit_is_mock_location")

  // Completion proof
  completionNote         String?   @map("completion_note") @db.Text
  surveyData             Json?     @map("survey_data") // Marketing executive survey captured at the stop
  completedAt            DateTime? @map("completed_at") @db.Timestamptz
  completeLat            Decimal?  @map("complete_lat") @db.Decimal(10, 7)
  completeLng            Decimal?  @map("complete_lng") @db.Decimal(10, 7)
  completeDistanceMetres Decimal?  @map("complete_distance_metres") @db.Decimal(10, 2)

  // Late access: work after the deadline needs admin approval
  lateAccessStatus  LateAccessStatus @default(NONE) @map("late_access_status")
  lateRequestReason String?          @map("late_request_reason") @db.Text
  lateRequestedAt   DateTime?        @map("late_requested_at") @db.Timestamptz
  lateReviewedById  String?          @map("late_reviewed_by") @db.Uuid
  lateReviewedAt    DateTime?        @map("late_reviewed_at") @db.Timestamptz
  lateReviewNote    String?          @map("late_review_note") @db.Text
  lateAccessUntil   DateTime?        @map("late_access_until") @db.Timestamptz

  assignedById String   @map("assigned_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization @relation(fields: [organizationId], references: [id])
  employee       Employee     @relation(fields: [employeeId], references: [id])
  assignedBy     User         @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  lateReviewedBy User?        @relation("LateAccessReviewedBy", fields: [lateReviewedById], references: [id])

  @@index([employeeId, taskDate])
  @@index([organizationId, taskDate])
  @@index([organizationId, lateAccessStatus])
  @@map("field_tasks")
}

// Enrolled face template. Descriptors are computed on the phone by
// @vladmandic/human and compared on the server.
model FaceProfile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String   @unique @map("employee_id") @db.Uuid
  embeddings   Json // number[][]: one descriptor per enrolment sample
  photo        String   @db.Text // small JPEG data URL for admin review
  modelVersion String   @map("model_version") @db.VarChar(50)
  consentAt    DateTime @map("consent_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("face_profiles")
}

model AttendancePolicy {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId              String   @map("organization_id") @db.Uuid
  version                     Int
  isCurrent                   Boolean  @default(true) @map("is_current")
  morningStart                String   @map("morning_start") @db.VarChar(5) // Format HH:MM e.g. "09:00"
  morningEnd                  String   @map("morning_end") @db.VarChar(5) // Format HH:MM e.g. "09:20"
  eveningStart                String   @map("evening_start") @db.VarChar(5) // Format HH:MM e.g. "16:30"
  eveningEnd                  String   @map("evening_end") @db.VarChar(5) // Format HH:MM e.g. "17:00"
  defaultGeofenceRadiusMetres Int      @default(100) @map("default_geofence_radius_metres")
  minReportLength             Int      @default(5) @map("min_report_length")
  maxReportLength             Int      @default(500) @map("max_report_length")
  gpsAccuracyWarnMetres       Int      @default(100) @map("gps_accuracy_warn_metres")
  gpsAccuracyRejectMetres     Int      @default(200) @map("gps_accuracy_reject_metres")
  faceVerificationRequired    Boolean  @default(true) @map("face_verification_required")
  faceMatchThreshold          Float    @default(0.5) @map("face_match_threshold")
  lateAccessHours             Int      @default(24) @map("late_access_hours")
  timezone                    String   @default("Asia/Kolkata") @db.VarChar(50)
  effectiveFrom               DateTime @map("effective_from") @db.Date
  notes                       String?  @db.Text
  createdById                 String   @map("created_by") @db.Uuid
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization      Organization       @relation(fields: [organizationId], references: [id])
  createdBy         User               @relation("PolicyCreatedBy", fields: [createdById], references: [id])
  attendanceRecords AttendanceRecord[]

  @@unique([organizationId, version])
  @@index([organizationId, isCurrent])
  @@map("attendance_policies")
}

model AttendanceRecord {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId      String           @map("employee_id") @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  workDate        DateTime         @map("work_date") @db.Date
  policyVersionId String           @map("policy_version_id") @db.Uuid
  status          AttendanceStatus @default(CHECKED_IN)
  shiftId         String?          @map("shift_id") @db.Uuid
  shiftName       String?          @map("shift_name") @db.VarChar(100)
  isLate          Boolean          @default(false) @map("is_late")

  // Check-In Details
  checkInAt              DateTime?        @map("check_in_at") @db.Timestamptz
  checkInLat             Decimal?         @map("check_in_lat") @db.Decimal(10, 7)
  checkInLng             Decimal?         @map("check_in_lng") @db.Decimal(10, 7)
  checkInAccuracyMetres  Decimal?         @map("check_in_accuracy_metres") @db.Decimal(8, 2)
  checkInGeofenceValid   Boolean?         @map("check_in_geofence_valid")
  checkInDistanceMetres  Decimal?         @map("check_in_distance_metres") @db.Decimal(10, 2)
  checkInLocationRefId   String?          @map("check_in_location_ref_id") @db.Uuid
  checkInLocationRefType LocationRefType? @map("check_in_location_ref_type")
  checkInLocationName    String?          @map("check_in_location_name") @db.VarChar(255)
  checkInFaceScore       Float?           @map("check_in_face_score")
  checkInSelfie          String?          @map("check_in_selfie") @db.Text
  checkInIsMockLocation  Boolean?         @map("check_in_is_mock_location")

  // Check-Out Details (Master instruction correction R-3: Dual snapshot preservation)
  checkOutAt              DateTime?        @map("check_out_at") @db.Timestamptz
  checkOutLat             Decimal?         @map("check_out_lat") @db.Decimal(10, 7)
  checkOutLng             Decimal?         @map("check_out_lng") @db.Decimal(10, 7)
  checkOutAccuracyMetres  Decimal?         @map("check_out_accuracy_metres") @db.Decimal(8, 2)
  checkOutGeofenceValid   Boolean?         @map("check_out_geofence_valid")
  checkOutDistanceMetres  Decimal?         @map("check_out_distance_metres") @db.Decimal(10, 2)
  checkOutLocationRefId   String?          @map("check_out_location_ref_id") @db.Uuid
  checkOutLocationRefType LocationRefType? @map("check_out_location_ref_type")
  checkOutLocationName    String?          @map("check_out_location_name") @db.VarChar(255)
  checkOutFaceScore       Float?           @map("check_out_face_score")
  checkOutSelfie          String?          @map("check_out_selfie") @db.Text

  // Work Report & Admin Flags
  workReport     String?  @map("work_report") @db.Text
  isCorrected    Boolean  @default(false) @map("is_corrected")
  isAdminCreated Boolean  @default(false) @map("is_admin_created")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  employee      Employee               @relation(fields: [employeeId], references: [id])
  organization  Organization           @relation(fields: [organizationId], references: [id])
  policyVersion AttendancePolicy       @relation(fields: [policyVersionId], references: [id])
  corrections   AttendanceCorrection[]

  @@unique([employeeId, workDate])
  @@index([organizationId, workDate])
  @@index([employeeId, workDate])
  @@index([status])
  @@map("attendance_records")
}

model AttendanceCorrection {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendanceRecordId String?          @map("attendance_record_id") @db.Uuid
  employeeId         String           @map("employee_id") @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  correctionType     CorrectionType   @map("correction_type")
  status             CorrectionStatus @default(PENDING)
  employeeReason     String           @map("employee_reason") @db.Text
  adminReason        String?          @map("admin_reason") @db.Text
  originalState      Json?            @map("original_state")
  correctedState     Json?            @map("corrected_state")
  requestedById      String           @map("requested_by") @db.Uuid
  reviewedById       String?          @map("reviewed_by") @db.Uuid
  requestedAt        DateTime         @default(now()) @map("requested_at") @db.Timestamptz
  reviewedAt         DateTime?        @map("reviewed_at") @db.Timestamptz

  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id])
  employee         Employee          @relation(fields: [employeeId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
  requestedBy      User              @relation("RequestedBy", fields: [requestedById], references: [id])
  reviewedBy       User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([organizationId, status])
  @@index([employeeId])
  @@map("attendance_corrections")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  actorRole      String   @map("actor_role") @db.VarChar(50)
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id") @db.Uuid
  beforeState    Json?    @map("before_state")
  afterState     Json?    @map("after_state")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.Text
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User         @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Holiday {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  holidayDate    DateTime @map("holiday_date") @db.Date
  name           String   @db.VarChar(255)
  description    String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, holidayDate])
  @@index([organizationId, holidayDate])
  @@map("holidays")
}

// Work shift for shift-wise attendance (pharmacy hubs & shops, laboratories, any location).
// Times are IST wall-clock. A shift whose end is not after its start runs overnight.
model Shift {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  branchId              String?  @map("branch_id") @db.Uuid // null = usable at any location
  name                  String   @db.VarChar(100)
  startTime             String   @map("start_time") @db.VarChar(5)
  endTime               String   @map("end_time") @db.VarChar(5)
  checkInBeforeMinutes  Int      @default(30) @map("check_in_before_minutes") // window opens before start
  lateGraceMinutes      Int      @default(15) @map("late_grace_minutes") // check-in after start + grace = late
  checkInAfterMinutes   Int      @default(60) @map("check_in_after_minutes") // window closes after start
  checkOutBeforeMinutes Int      @default(15) @map("check_out_before_minutes")
  checkOutAfterMinutes  Int      @default(120) @map("check_out_after_minutes")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employees    Employee[]

  @@index([organizationId])
  @@map("shifts")
}

// Health / promotion camp. Only assigned staff can mark camp attendance, only inside its geofence.
model Camp {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  branchId       String?       @map("branch_id") @db.Uuid // organising location (optional)
  name           String        @db.VarChar(255)
  description    String?       @db.Text
  campDate       DateTime      @map("camp_date") @db.Date
  startTime      String        @map("start_time") @db.VarChar(5)
  endTime        String        @map("end_time") @db.VarChar(5)
  locationName   String        @map("location_name") @db.VarChar(255)
  address        String?       @db.Text
  latitude       Decimal       @db.Decimal(10, 7)
  longitude      Decimal       @db.Decimal(10, 7)
  radiusMetres   Int           @default(200) @map("radius_metres")
  geofenceShape  GeofenceShape @default(CIRCLE) @map("geofence_shape")
  boundary       Json?
  boundaryLabel  String?       @map("boundary_label") @db.VarChar(255)
  isCancelled    Boolean       @default(false) @map("is_cancelled")
  createdById    String        @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id])
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("CampCreatedBy", fields: [createdById], references: [id])
  assignments  CampAssignment[]

  @@index([organizationId, campDate])
  @@map("camps")
}

model CampAssignment {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campId                 String    @map("camp_id") @db.Uuid
  employeeId             String    @map("employee_id") @db.Uuid
  checkInAt              DateTime? @map("check_in_at") @db.Timestamptz
  checkInLat             Decimal?  @map("check_in_lat") @db.Decimal(10, 7)
  checkInLng             Decimal?  @map("check_in_lng") @db.Decimal(10, 7)
  checkInAccuracyMetres  Decimal?  @map("check_in_accuracy_metres") @db.Decimal(8, 2)
  checkInDistanceMetres  Decimal?  @map("check_in_distance_metres") @db.Decimal(10, 2)
  checkInFaceScore       Float?    @map("check_in_face_score")
  checkInSelfie          String?   @map("check_in_selfie") @db.Text
  checkInIsMockLocation  Boolean?  @map("check_in_is_mock_location")
  checkOutAt             DateTime? @map("check_out_at") @db.Timestamptz
  checkOutLat            Decimal?  @map("check_out_lat") @db.Decimal(10, 7)
  checkOutLng            Decimal?  @map("check_out_lng") @db.Decimal(10, 7)
  checkOutDistanceMetres Decimal?  @map("check_out_distance_metres") @db.Decimal(10, 2)
  checkOutFaceScore      Float?    @map("check_out_face_score")
  report                 String?   @db.Text
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz

  camp     Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([campId, employeeId])
  @@index([employeeId])
  @@map("camp_assignments")
}

// Customer master for sales executives (pharmacies, clinics, doctors... in a DC territory)
model Customer {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid // distribution centre
  name           String   @db.VarChar(255)
  customerType   String?  @map("customer_type") @db.VarChar(60)
  contactPerson  String?  @map("contact_person") @db.VarChar(255)
  mobile         String?  @db.VarChar(15)
  address        String?  @db.Text
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  notes          String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  addedById      String   @map("added_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  addedBy      User         @relation("CustomerAddedBy", fields: [addedById], references: [id])

  @@index([organizationId, branchId])
  @@map("customers")
}
